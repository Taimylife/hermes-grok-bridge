# Native Hermes A2A receiver settings. Replace every placeholder locally.
# Use a private-network interface/proxy only; follow the official A2A guide.
A2A_PORT=9900
A2A_AGENT_NAME=hermes-research
A2A_PEER_TOKENS=grok-research:replace-with-random-token,grok-operations:replace-with-random-token
A2A_TRUSTED_PEERS=grok-research,grok-operations

# If a private reverse proxy provides the reachable URL, advertise that URL:
# A2A_PUBLIC_URL=https://hermes-research.your-private-network.example

# A2A_HOST is intentionally omitted: keep Hermes' safe localhost default unless
# your private-network routing and host firewall are configured for remote access.
